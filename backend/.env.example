# Copy to .env and fill in your own values. Never commit .env.
# Server
PORT=5000
NODE_ENV=development
# Database — MongoDB Atlas in production, e.g. mongodb+srv://<user>:<password>@<cluster>/vera
MONGO_URI=mongodb://localhost:27017/vera
# Local testing only: true uses an in-memory database and ignores MONGO_URI
USE_MEMORY_DB=false
# Auth — must be a long random secret, never the placeholder below
JWT_SECRET=change-this-to-a-long-random-secret
# Frontend origin allowed by CORS (your Vercel URL in production)
CLIENT_URL=http://localhost:5173
# Seed accounts — required by `npm run seed`. Use strong passwords.
SEED_ADMIN_EMAIL=admin@vera.example
SEED_ADMIN_PASSWORD=change-this-to-a-long-random-password
SEED_USER_EMAIL=user@vera.example
SEED_USER_PASSWORD=change-this-to-a-long-random-password
